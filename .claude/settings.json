{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "WebSearch",
      "WebFetch",
      "mcp__supabase",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./.agents/skills/**)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(telnet:*)",
      "Bash(nc:*)",
      "Bash(scp:*)",
      "Bash(ssh:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npx skills:*)",
      "Bash(npm publish:*)",
      "Bash(npm install -g:*)",
      "Bash(docker compose down:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(pip install:*)",
      "Bash(alembic:*)",
      "Bash(git commit:*)"
    ],
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff check:*)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [
    "supabase"
  ],
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              ".claude/hooks/restrict-write-scope.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Checking agent write scope"
          }
        ]
      }
    ]
  }
}
