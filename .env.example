# Template only. This file is committed, so every value here must stay a
# placeholder. Copy it to .env and put real values there — .env is gitignored.
ENVIRONMENT=development

# Keys every session token, CSRF token and email-verification token in the
# database, so rotating it signs every user out. Use a distinct random value
# per environment and never ship the placeholder below.
#   PowerShell: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-32-character-minimum-secret
DATABASE_URL=postgresql+asyncpg://lura:lura@localhost:5432/lura
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3001/
ALLOWED_ORIGINS=http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1,api
COOKIE_SECURE=false
MAX_ACTIVE_SESSIONS=10
REQUEST_MAX_BYTES=65536
TRUSTED_PROXY_HOSTS=

# Public auth abuse controls.
LOGIN_IP_LIMIT=20
LOGIN_ACCOUNT_LIMIT=10
LOGIN_WINDOW_SECONDS=900
LOGIN_CAPTCHA_THRESHOLD=3
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_SECONDS=300
REGISTER_IP_LIMIT=5
REGISTER_ACCOUNT_LIMIT=3
PASSWORD_RESET_IP_LIMIT=5
PASSWORD_RESET_ACCOUNT_LIMIT=3

# Cloudflare Turnstile. Production startup requires these values.
CAPTCHA_PROVIDER=disabled
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Transactional email. When absent in development, messages are safely suppressed.
RESEND_API_KEY=
EMAIL_FROM=Lura <auth@example.com>

# Google OAuth. Set the callback URL in Google Cloud to this same value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# AI providers. These values are backend-only. Never add them as NEXT_PUBLIC variables.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_RUNTIME_TIMEOUT_SECONDS=60
AI_RUNTIME_MAX_HISTORY_MESSAGES=24

# Supabase Auth is the identity provider for email sign-up and sign-in.
# Both values are public by design: the publishable key only ever grants the
# `anon` role and every table it can reach is behind row-level security, so
# these are the one pair of credentials that may also reach the browser.
# Find them under Project Settings -> API Keys in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Origin the auth app is served on. It must also be listed in the Supabase
# dashboard under Authentication -> URL Configuration, or Supabase will refuse
# to redirect confirmation links back here.
AUTH_APP_URL=http://localhost:3001

# Frontend public configuration.
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_AUTH_APP_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
