# Template for apps/web/.env.local, which `next dev` and `next build` read when
# the app runs outside Docker. Copy this to .env.local and fill in the values.
#
# Everything here is public by definition: NEXT_PUBLIC_* is inlined into the
# browser bundle. Never add a secret, service-role key, or provider token.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Origin this app answers on. Confirmation links come back here, so it must be
# listed in the Supabase dashboard under Authentication -> URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Рабочее пространство Lura Studio (/studio). Всё ниже читается только на
# сервере — в браузерный бандл не попадает ничего, потому что нет NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Ключ Google AI Studio. Без него /studio открывается, но разбор не запускается.
GEMINI_API_KEY=

# Модель по умолчанию и запасные. У gemini-3.1-pro на бесплатном тарифе дневная
# квота равна нулю: пока у проекта нет биллинга, клиент спускается по цепочке и
# показывает в интерфейсе, какая модель ответила на самом деле.
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.1-flash-lite

# Поиск в интернете: auto | gemini | brave | tavily | duckduckgo.
# auto пробует по порядку brave -> tavily -> gemini -> duckduckgo.
# googleSearch у Gemini включается вместе с биллингом; brave и tavily — по ключу.
STUDIO_SEARCH=auto
BRAVE_API_KEY=
TAVILY_API_KEY=

# Хранилище состояния. Пусто — файлы в .lura-studio рядом с приложением: так
# работает локальный запуск и сервер со своим диском. Задано — состояние уходит
# в Postgres, и рабочее пространство можно разворачивать на Vercel, где
# файловая система доступна только для чтения.
#
# Для Vercel берите строку transaction pooler (порт 6543):
# Supabase -> Connect -> Transaction pooler.
# STUDIO_DATABASE_URL=postgresql://postgres.<ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:6543/postgres

# Куда класть файлы, когда хранилище файловое.
# STUDIO_DATA_DIR=

# Открыть /studio без входа через Supabase. По умолчанию открыт только в разработке.
# STUDIO_PUBLIC=true
